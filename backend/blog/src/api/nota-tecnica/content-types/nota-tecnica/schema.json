{
  "kind": "collectionType",
  "collectionName": "nota_tecnicas",
  "info": {
    "singularName": "nota-tecnica",
    "pluralName": "nota-tecnicas",
    "displayName": "Nota Técnica"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "id_nota_tecnica": {
      "type": "uid",
      "required": true
    },
    "capa": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "titulo": {
      "type": "string",
      "required": true
    },
    "data_publicacao": {
      "type": "date",
      "required": true
    },
    "texto": {
      "type": "richtext",
      "required": true
    },
    "documentos_extras": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "texto_pesquisador": {
      "type": "string"
    },
    "resumo": {
      "type": "richtext",
      "required": true
    }
  }
}
